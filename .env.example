# Copy to .env and fill in. Never commit .env.
# Paths are relative to the project root; everything stays inside this folder (docs/SETUP.md).

# --- Keys (owner creates these; see docs/SETUP.md)
OPENFDA_API_KEY=        # free: https://open.fda.gov/apis/authentication/
HF_TOKEN=               # https://huggingface.co/settings/tokens (write scope for model upload)

# --- Local services and caches
OLLAMA_HOST=http://localhost:11434
HF_HOME=.cache/huggingface   # Hugging Face models/datasets cache
